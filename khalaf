name: jadwali_pro
description: تطبيق الجدول المدرسي مفتوح
version: 1.0.0+1
environment: {sdk: '>=3.0.0 <4.0.0'}
dependencies: {flutter: {sdk: flutter}, shared_preferences: ^2.2.3, pdf: ^3.10.8, printing: ^5.11.2}
flutter: {uses-material-design: true}
import 'package:flutter/material.dart';
import 'package:shared_preferences/shared_preferences.dart';
import 'package:pdf/pdf.dart';
import 'package:pdf/widgets.dart' as pw;
import 'package:printing/printing.dart';
import 'dart:convert';
import 'dart:math';

void main() => runApp(MyApp());
class MyApp extends StatelessWidget {
  @override Widget build(BuildContext context) {
    return MaterialApp(title: 'جدولي المدرسي PRO+', theme: ThemeData(primarySwatch: Colors.teal), home: HomePage(), debugShowCheckedModeBanner: false);
  }
}
class HomePage extends StatefulWidget {
  @override _HomePageState createState() => _HomePageState();
}
class _HomePageState extends State<HomePage> {
  List<String> schoolDays = ['الاحد','الاثنين','الثلاثاء','الاربعاء','الخميس'];
  List<String> offDays = [];
  int periodsPerDay = 6;
  List<String> subjects = ['رياضيات','عربي','انكليزي'];
  Map<String, int> subjectPeriods = {};
  Map<String, bool> allowDouble = {};
  Map<String, List<String>> subjectTeachers = {};
  Map<String, List<Map>> timetable = {};

  @override void initState() {super.initState(); loadSettings();}
  loadSettings() async {
    SharedPreferences prefs = await SharedPreferences.getInstance();
    setState(() {
      schoolDays = prefs.getStringList('schoolDays')?? schoolDays;
      offDays = prefs.getStringList('offDays')?? [];
      periodsPerDay = prefs.getInt('periodsPerDay')?? 6;
      subjects = prefs.getStringList('subjects')?? subjects;
      String? periodsData = prefs.getString('subjectPeriods'); if(periodsData!= null) subjectPeriods = Map<String,int>.from(json.decode(periodsData));
      String? doubleData = prefs.getString('allowDouble'); if(doubleData!= null) allowDouble = Map<String,bool>.from(json.decode(doubleData));
      String? teachersData = prefs.getString('subjectTeachers'); if(teachersData!= null) subjectTeachers = Map<String,List<String>>.from(json.decode(teachersData).map((k,v)=>MapEntry(k,List<String>.from(v))));
      String? timetableData = prefs.getString('timetable'); if(timetableData!= null) timetable = Map<String,List<Map>>.from(json.decode(timetableData));
    });
  }
  saveSettings() async {
    SharedPreferences prefs = await SharedPreferences.getInstance();
    prefs.setStringList('schoolDays', schoolDays);
    prefs.setStringList('offDays', offDays);
    prefs.setInt('periodsPerDay', periodsPerDay);
    prefs.setStringList('subjects', subjects);
    prefs.setString('subjectPeriods', json.encode(subjectPeriods));
    prefs.setString('allowDouble', json.encode(allowDouble));
    prefs.setString('subjectTeachers', json.encode(subjectTeachers));
    prefs.setString('timetable', json.encode(timetable));
  }
  void showGeneralSettings() {
    TextEditingController subjectController = TextEditingController();
    showDialog(context: context, builder: (_) => StatefulBuilder(builder: (context, setStateDialog) => AlertDialog(
      title: Text('الاعدادات العامة'),
      content: Container(width: 350, height: 500, child: SingleChildScrollView(child: Column(children: [
        Text('ايام الدراسة', style: TextStyle(fontWeight: FontWeight.bold)),
      ...['السبت','الاحد','الاثنين','الثلاثاء','الاربعاء','الخميس'].map((day)=> CheckboxListTile(title: Text(day), value: schoolDays.contains(day), onChanged: (val){ setStateDialog((){ if(val!) schoolDays.add(day); else schoolDays.remove(day);});}))),
        Divider(),
        Row(children: [Text('عدد الحص باليوم: '), IconButton(icon: Icon(Icons.remove), onPressed: (){setStateDialog((){if(periodsPerDay>1) periodsPerDay--;});}), Text('$periodsPerDay'), IconButton(icon: Icon(Icons.add), onPressed: (){setStateDialog((){periodsPerDay++;});})]),
        Divider(),
        Text('المواد الدراسية', style: TextStyle(fontWeight: FontWeight.bold)),
        Row(children: [Expanded(child: TextField(controller: subjectController, decoration: InputDecoration(labelText: 'اسم المادة'))), IconButton(icon: Icon(Icons.add), onPressed: (){setStateDialog((){if(subjectController.text.isNotEmpty) subjects.add(subjectController.text); subjectController.clear();});})]),
      ...subjects.map((s)=> ListTile(title: Text(s), trailing: IconButton(icon: Icon(Icons.delete), onPressed: (){setStateDialog((){subjects.remove(s);});})))
      ]))),
      actions: [TextButton(onPressed: (){Navigator.pop(context);}, child: Text('الغاء')), TextButton(onPressed: (){setState((){}); saveSettings(); autoFillTimetable(); Navigator.pop(context);}, child: Text('حفظ'))],
    ))));
  }
  Future<void> exportFullTimetablePDF() async {
    final pdf = pw.Document(); List<String> activeDays = schoolDays.where((d) =>!offDays.contains(d)).toList();
    pdf.addPage(pw.MultiPage(pageFormat: PdfPageFormat.a4, build: (pw.Context context) { return [
      pw.Center(child: pw.Text('الجدول الدراسي', style: pw.TextStyle(fontSize: 22, fontWeight: pw.FontWeight.bold))), pw.SizedBox(height: 20),
      pw.Table(border: pw.TableBorder.all(), children: [
        pw.TableRow(children: [pw.Padding(padding: pw.EdgeInsets.all(5), child: pw.Text('الحصة', style: pw.TextStyle(fontWeight: pw.FontWeight.bold))),...activeDays.map((day)=> pw.Padding(padding: pw.EdgeInsets.all(5), child: pw.Text(day, style: pw.TextStyle(fontWeight: pw.FontWeight.bold))))]),
     ...List.generate(periodsPerDay, (i){ return pw.TableRow(children: [pw.Padding(padding: pw.EdgeInsets.all(5), child: pw.Text('${i+1}')),...activeDays.map((day){ String subject = timetable[day]?[i]['subject']?? ''; String teacher = timetable[day]?[i]['teacher']?? ''; return pw.Padding(padding: pw.EdgeInsets.all(5), child: pw.Column(crossAxisAlignment: pw.CrossAxisAlignment.end, children: [pw.Text(subject.isEmpty? '-' : subject), pw.Text(teacher, style: pw.TextStyle(fontSize: 8, color: PdfColors.grey))]))})]);})
      ])
    ];}));
    await Printing.layoutPdf(onLayout: (PdfPageFormat format) async => pdf.save());
  }
  Future<void> exportTeacherPDF(String teacherName) async {
    final pdf = pw.Document(); List<pw.TableRow> rows = [pw.TableRow(children: [pw.Text('اليوم', style: pw.TextStyle(fontWeight: pw.FontWeight.bold)), pw.Text('الحصة', style: pw.TextStyle(fontWeight: pw.FontWeight.bold)), pw.Text('المادة', style: pw.TextStyle(fontWeight: pw.FontWeight.bold))])];
    timetable.forEach((day, periods){ for(int i=0; i<periods.length; i++){ if(periods[i]['teacher'] == teacherName){ rows.add(pw.TableRow(children: [pw.Text(day), pw.Text('${i+1}'), pw.Text(periods[i]['subject'])]));}}});
    pdf.addPage(pw.Page(pageFormat: PdfPageFormat.a4, build: (pw.Context context) { return pw.Column(crossAxisAlignment: pw.CrossAxisAlignment.end, children: [pw.Text('جدول الاستاذ: $teacherName', style: pw.TextStyle(fontSize: 20, fontWeight: pw.FontWeight.bold)), pw.SizedBox(height: 20), pw.Table(border: pw.TableBorder.all(), children: rows)]);}));
    await Printing.layoutPdf(onLayout: (PdfPageFormat format) async => pdf.save());
  }
  void showTeacherTimetableDialog() {
    List<String> allTeachers = subjectTeachers.values.expand((e) => e).toSet().toList(); String? selectedTeacher;
    showDialog(context: context, builder: (_) => StatefulBuilder(builder: (context, setStateDialog) => AlertDialog(title: Text('جدول الاستاذ'), content: Container(width: 350, height: 500, child: Column(children: [
      DropdownButtonFormField<String>(hint: Text('اختر الاستاذ'), value: selectedTeacher, items: allTeachers.map((t)=>DropdownMenuItem(value: t, child: Text(t))).toList(), onChanged: (v){ setStateDialog((){selectedTeacher = v;});}),
      SizedBox(height: 10), Expanded(child: selectedTeacher == null? Center(child: Text('اختر استاذ لعرض جدوله')) : TeacherTimetableView(teacherName: selectedTeacher!, timetable: timetable)),
      if(selectedTeacher!= null) ElevatedButton.icon(icon: Icon(Icons.picture_as_pdf), label: Text('تصدير PDF وطباعة'), onPressed: (){ exportTeacherPDF(selectedTeacher!); })
    ])), actions: [TextButton(onPressed: (){Navigator.pop(context);}, child: Text('اغلاق'))],)));
  }
  void showTeachersDialog(String subject) {TextEditingController nameController = TextEditingController(); showDialog(context: context, builder: (_) => StatefulBuilder(builder: (context, setStateDialog) => AlertDialog(title: Text('اساتذة مادة $subject'), content: Container(width: 300, height: 300, child: Column(children: [
    Row(children: [Expanded(child: TextField(controller: nameController, decoration: InputDecoration(labelText: 'اسم الاستاذ'))), IconButton(icon: Icon(Icons.add), onPressed: (){ setStateDialog(() { subjectTeachers[subject] = subjectTeachers[subject]?? []; if(nameController.text.isNotEmpty) subjectTeachers[subject]!.add(nameController.text); nameController.clear();});})]),
    Expanded(child: ListView(children: (subjectTeachers[subject]?? []).map((t)=>ListTile(title: Text(t), trailing: IconButton(icon: Icon(Icons.delete, color: Colors.red), onPressed: (){ setStateDialog((){subjectTeachers[subject]!.remove(t);});}))).toList()))
  ])), actions: [TextButton(onPressed: (){Navigator.pop(context);}, child: Text('اغلاق')), TextButton(onPressed: (){saveSettings(); Navigator.pop(context);}, child: Text('حفظ'))],)));}
  void showSubjectPeriodsDialog() {
    showDialog(context: context, builder: (_) => StatefulBuilder(builder: (context, setStateDialog) => AlertDialog(title: Text('توزيع حصص المواد'), content: Container(width: 320, height: 500, child: ListView(children: subjects.map((subject){ return Card(child: ExpansionTile(title: Text(subject), subtitle: Text('الحص: ${subjectPeriods[subject]?? 1} | الاساتذة: ${(subjectTeachers[subject]?? []).length}'), children: [
      SwitchListTile(title: Text('السماح بحصتين متتاليتين'), value: allowDouble[subject]?? false, onChanged: (val){ setStateDialog(() { allowDouble[subject] = val; });}),
      Row(children: [Text('عدد الحص'), IconButton(icon: Icon(Icons.remove), onPressed: (){ setStateDialog(() { subjectPeriods[subject] = (subjectPeriods[subject]?? 1) - 1; if(subjectPeriods[subject]! < 0) subjectPeriods[subject] = 0;});}), Text('${subjectPeriods[subject]?? 1}'), IconButton(icon: Icon(Icons.add), onPressed: (){ setStateDialog(() { subjectPeriods[subject] = (subjectPeriods[subject]?? 1) + 1;});})]),
      TextButton.icon(icon: Icon(Icons.people), label: Text('ادارة الاساتذة'), onPressed: (){showTeachersDialog(subject);})
    ],));}).toList())), actions: [TextButton(onPressed: (){Navigator.pop(context);}, child: Text('الغاء')), TextButton(onPressed: (){ setState((){}); saveSettings(); autoFillTimetable(); Navigator.pop(context);}, child: Text('توزيع تلقائي'))],)));}
  void autoFillTimetable() async {
    List<String> activeDays = schoolDays.where((d) =>!offDays.contains(d)).toList();
    Map<String, List<Map>> newTimetable = {}; for(var day in activeDays){ newTimetable[day] = List.generate(periodsPerDay, (i) => {'subject':'','teacher':''}); }
    Random rnd = Random(); subjectPeriods.forEach((subject, count){ List<String> teachers = subjectTeachers[subject]?? ['غير محدد']; int teacherIndex = 0; for(int i=0; i<count; i++){ int dayIdx = rnd.nextInt(activeDays.length); int periodIdx = rnd.nextInt(periodsPerDay); String day = activeDays[dayIdx]; String teacher = teachers[teacherIndex % teachers.length]; if(newTimetable[day]![periodIdx]['subject'] == ''){ newTimetable[day]![periodIdx]['subject'] = subject; newTimetable[day]![periodIdx]['teacher'] = teacher; teacherIndex++; if(allowDouble[subject] == true && i < count-1){ if(periodIdx < periodsPerDay-1 && newTimetable[day]![periodIdx+1]['subject'] == ''){ newTimetable[day]![periodIdx+1]['subject'] = subject; newTimetable[day]![periodIdx+1]['teacher'] = teacher; i++;}}}}});
    setState((){timetable = newTimetable;}); saveSettings();
  }
  void showOffDaysDialog() {showDialog(context: context, builder: (_) => StatefulBuilder(builder: (context, setStateDialog) => AlertDialog(title: Text('ايام الاستراحة'), content: Column(mainAxisSize: MainAxisSize.min, children: schoolDays.map((day){ return CheckboxListTile(title: Text(day), value: offDays.contains(day), onChanged: (val){ setStateDialog(() { if(val!) offDays.add(day); else offDays.remove(day);});}).toList()), actions: [TextButton(onPressed: (){Navigator.pop(context);}, child: Text('الغاء')), TextButton(onPressed: (){ setState((){}); saveSettings(); Navigator.pop(context);}, child: Text('حفظ'))],),));}
  @override Widget build(BuildContext context) {
    List<String> activeDays = schoolDays.where((d) =>!offDays.contains(d)).toList();
    return Scaffold(body: Container(
      decoration: BoxDecoration(gradient: LinearGradient(colors: [Colors.teal.shade100, Colors.teal.shade400], begin: Alignment.topCenter, end: Alignment.bottomCenter)),
      child: Column(children: [
        AppBar(
          title: Text('جدولي المدرسي'),
          backgroundColor: Colors.teal.withOpacity(0.85),
          actions: [
            IconButton(icon: Icon(Icons.settings), tooltip: 'الاعدادات العامة', onPressed: showGeneralSettings),
            IconButton(icon: Icon(Icons.picture_as_pdf), tooltip: 'تصدير الجدول الكامل', onPressed: exportFullTimetablePDF),
            IconButton(icon: Icon(Icons.person), tooltip: 'جدول الاستاذ', onPressed: showTeacherTimetableDialog),
            IconButton(icon: Icon(Icons.schedule), tooltip: 'توزيع الحص', onPressed: showSubjectPeriodsDialog),
            IconButton(icon: Icon(Icons.beach_access), tooltip: 'ايام الاستراحة', onPressed: showOffDaysDialog),
          ],
        ),
        Expanded(child: TimetablePage(days: activeDays, periods: periodsPerDay, subjects: subjects, timetable: timetable, onUpdate: (t){setState((){timetable=t;}); saveSettings();})),
      ]),
    ));
  }
}
class TeacherTimetableView extends StatelessWidget {
  final String teacherName; final Map<String, List<Map>> timetable;
  TeacherTimetableView({required this.teacherName, required this.timetable});
  @override Widget build(BuildContext context) {
    List<Widget> teacherSchedule = []; timetable.forEach((day, periods){ for(int i=0; i<periods.length; i++){ if(periods[i]['teacher'] == teacherName){ teacherSchedule.add(ListTile(leading: Chip(label: Text(day)), title: Text(periods[i]['subject']), subtitle: Text('الحصة ${i+1}')));}}});
    return teacherSchedule.isEmpty? Center(child: Text('لا توجد حصص لهذا الاستاذ')) : ListView(children: teacherSchedule);
  }
}
class TimetablePage extends StatefulWidget {
  final List<String> days; final int periods; final List<String> subjects; final Map<String, List<Map>> timetable; final Function(Map) onUpdate;
  TimetablePage({required this.days, required this.periods, required this.subjects, required this.timetable, required this.onUpdate});
  @override _TimetablePageState createState() => _TimetablePageState();
}
class _TimetablePageState extends State<TimetablePage> {
  @override Widget build(BuildContext context) {
    return DefaultTabController(length: widget.days.length, child: Column(children: [
      TabBar(isScrollable: true, tabs: widget.days.map((d)=>Tab(text:d)).toList()),
      Expanded(child: TabBarView(children: widget.days.map((day){ return ListView.builder(itemCount: widget.periods, itemBuilder: (_, i) => Card(color: Colors.white.withOpacity(0.9), margin: EdgeInsets.all(8), child: ListTile(leading: CircleAvatar(child: Text('${i+1}')), title: Text(widget.timetable[day]?[i]['subject'].isEmpty?? true? 'اضغط للاختيار' : widget.timetable[day]![i]['subject']), subtitle: Text(widget.timetable[day]?[i]['teacher']?? ''), trailing: Icon(Icons.edit, color: Colors.teal), onTap: ()=>editCell(day, i),);}).toList())),
    ]));
  }
  void editCell(String day, int index) {String? selectedSubject; TextEditingController teacher = TextEditingController(text: widget.timetable[day]?[index]['teacher']?? ''); showDialog(context: context, builder: (_) => AlertDialog(title: Text('الحصة ${index+1} - $day'), content: Column(mainAxisSize: MainAxisSize.min, children: [DropdownButtonFormField<String>(hint: Text('اختر المادة'), value: widget.timetable[day]?[index]['subject'].isEmpty?? true? null : widget.timetable[day]![index]['subject'], items: widget.subjects.map((s)=>DropdownMenuItem(value:s, child: Text(s))).toList(), onChanged: (v){selectedSubject = v;}), TextField(controller: teacher, decoration: InputDecoration(labelText: 'اسم الاستاذ')),]), actions: [TextButton(onPressed: (){Navigator.pop(context);}, child: Text('الغاء')), TextButton(onPressed: (){ setState(() { widget.timetable[day]![index] = {'subject': selectedSubject?? widget.timetable[day]![index]['subject'], 'teacher': teacher.text};}); widget.onUpdate(widget.timetable); Navigator.pop(context);}, child: Text('حفظ')),],));}
}workflows:
  android-release:
    name: Build Android APK
    instance_type: mac_mini_m1
    environment:
      flutter: stable
    scripts:
      - flutter pub get
      - flutter build apk --release
    artifacts:
      - build/app/outputs/flutter-apk/app-release.apk
    publishing:
      email:
        recipients:
          - khalaff.ffaisal@gmail.com
